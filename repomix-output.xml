    function getCapturedAudioTrackFromElement() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContextClass();
        audioSourceNode = audioCtx.createMediaElementSource(cinemaAudio);
        audioDestNode = audioCtx.createMediaStreamDestination();
        audioSourceNode.connect(audioCtx.destination);
        audioSourceNode.connect(audioDestNode);
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
      return audioDestNode.stream.getAudioTracks()[0];
    }

    function formatTime(sec) {
      if (!isFinite(sec) || sec < 0) return '00:00';
      const hrs = Math.floor(sec / 3600);
      const mins = Math.floor((sec % 3600) / 60);
      const secs = Math.floor(sec % 60);
      const mm = mins < 10 ? `0${mins}` : `${mins}`;
      const ss = secs < 10 ? `0${secs}` : `${secs}`;
      return hrs > 0 ? `${hrs}:${mm}:${ss}` : `${mm}:${ss}`;
    }

    function updatePeerBadge() {
