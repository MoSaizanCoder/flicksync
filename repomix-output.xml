<file path="public/styles.css">
/* =========================================================
   RAMStream — Custom Responsive & Theater Fullscreen Styles
   ========================================================= */

:root {
  --bg-app: #060913;
  --bg-panel: #0f172a;
  --bg-card: #020617;
  --border-subtle: #1e293b;
  --accent-primary: #6366f1;
  --accent-emerald: #10b981;
  --accent-danger: #e11d48;
}

* {
  box-sizing: border-box;
}

body {
  background-color: var(--bg-app);
  color: #f1f5f9;
  margin: 0;
  overflow-x: hidden;
}

/* Custom sleek scrollbar for Live Video Call stack & Queue list */
.custom-scrollbar::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(15, 23, 42, 0.6);
  border-radius: 9999px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: #334155;
  border-radius: 9999px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #475569;
}

/* Main Workspace Layout (Normal Mode) */
.workspace-shell {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  padding: 0.75rem;
  max-width: 1440px;
  width: 100%;
  margin: 0 auto;
  flex: 1;
}

@media (min-width: 1024px) {
  .workspace-shell {
    grid-template-columns: minmax(0, 1fr) 310px;
    padding: 1rem;
  }
}

/* Video Call Sidebar Card */
.call-sidebar {
  background: var(--bg-panel);
  border: 1px solid var(--border-subtle);
  border-radius: 0.85rem;
  padding: 0.85rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-height: 0;
}

@media (min-width: 1024px) {
  .call-sidebar {
    height: calc(100vh - 84px);
    position: sticky;
    top: 1rem;
  }
}

/* Top Mic & Camera Control Bar inside Video Call Box */
.call-top-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  padding-bottom: 0.65rem;
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
}

/* Scrollable Webcam Tiles Container (Never squishes tiles; shows scrollbar for extra peers) */
.webcam-stack {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-rows: max-content;
  align-content: start;
  gap: 0.6rem;
  max-height: 260px;
  overflow-y: auto;
  padding-right: 4px;
  flex: 1;
  min-height: 0;
}

@media (min-width: 1024px) {
  .webcam-stack {
    grid-template-columns: 1fr;
    max-height: none;
  }
}

.cam-tile {
  position: relative;
  background: #000;
  border: 1px solid #334155;
  border-radius: 0.65rem;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  min-height: 112px;
  width: 100%;
  flex-shrink: 0;
}

.cam-tile video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cam-badge {
  position: absolute;
  bottom: 6px;
  left: 6px;
  background: rgba(2, 6, 23, 0.78);
  backdrop-filter: blur(4px);
  color: #e2e8f0;
  font-size: 11px;
  font-weight: 500;
  padding: 2px 8px;
  border-radius: 6px;
}

/* Custom Range Sliders (Movie Vol, Call Vol, Seek Bar) */
input[type="range"].studio-slider {
  -webkit-appearance: none;
  appearance: none;
  height: 5px;
  background: #1e293b;
  border-radius: 999px;
  outline: none;
  cursor: pointer;
}

input[type="range"].studio-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #818cf8;
  border: 2px solid #eef2ff;
  cursor: pointer;
  transition: transform 0.12s ease;
}

input[type="range"].studio-slider::-webkit-slider-thumb:hover {
  transform: scale(1.18);
}

input[type="range"].studio-slider.emerald::-webkit-slider-thumb {
  background: #34d399;
  border-color: #ecfdf5;
}

/* Side-Sliding Queue Drawer */
.queue-drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: min(320px, 86vw);
  background: #0b1120;
  border-left: 1px solid #334155;
  box-shadow: -12px 0 35px rgba(0, 0, 0, 0.75);
  z-index: 90;
  transform: translateX(105%);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  padding: 1rem;
}

.queue-drawer.open {
  transform: translateX(0);
}

.queue-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 85;
}

/* =========================================================
   THEATER FULLSCREEN MODE (Left 18% Rail + Right 82% Video)
   ========================================================= */
body.theater-fullscreen {
  overflow: hidden;
  height: 100vh;
  width: 100vw;
}

body.theater-fullscreen #topHeader,
body.theater-fullscreen #normalSourceBar,
body.theater-fullscreen #callSidebarHeader {
  display: none !important;
}

body.theater-fullscreen .workspace-shell {
  display: flex;
  flex-direction: row;
  padding: 0;
  margin: 0;
  max-width: 100vw;
  width: 100vw;
  height: 100vh;
  gap: 0;
}

/* RIGHT SIDE RAIL (18% width on desktop, compact rail on mobile) */
body.theater-fullscreen .call-sidebar {
  order: 2;
  width: 18%;
  min-width: 132px;
  max-width: 280px;
  height: 100vh;
  border-radius: 0;
  border: none;
  border-left: 1px solid #1e293b;
  background: #080d1a;
  padding: 0.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  z-index: 30;
}

/* Fullscreen Left Rail: Permanent Volume + Queue Icon Block */
.fs-left-controls {
  display: none;
}

body.theater-fullscreen .fs-left-controls {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding-bottom: 0.55rem;
  border-bottom: 1px solid #1e293b;
}

/* Single-column stacked webcams filling remaining left-rail space */
body.theater-fullscreen .webcam-stack {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1;
  max-height: none;
  overflow-y: auto;
  padding-right: 2px;
}

body.theater-fullscreen .cam-tile {
  flex-shrink: 0;
  aspect-ratio: 16 / 10;
  border-radius: 0.5rem;
}

/* LEFT SIDE STAGE (82% width, 100vh height) */
body.theater-fullscreen .theater-stage-col {
  order: 1;
  width: 82%;
  flex: 1;
  height: 100vh;
  position: relative;
  background: #000;
  gap: 0;
}

body.theater-fullscreen .video-frame-box {
  width: 100%;
  height: 100vh;
  aspect-ratio: auto;
  border: none;
  border-radius: 0;
}

/* Floating Playback Bar at Bottom of Right-Side Video in Fullscreen */
body.theater-fullscreen #customPlayerBar {
  position: absolute;
  bottom: 14px;
  left: 16px;
  right: 16px;
  background: rgba(15, 23, 42, 0.82);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(51, 65, 85, 0.8);
  z-index: 40;
  opacity: 0.92;
  transition: opacity 0.2s ease;
}

body.theater-fullscreen #customPlayerBar:hover {
  opacity: 1;
}

/* Mobile adjustments inside Theater Fullscreen */
@media (max-width: 768px) {
  body.theater-fullscreen .call-sidebar {
    width: 24%;
    min-width: 112px;
    padding: 0.4rem;
    gap: 0.4rem;
  }

  body.theater-fullscreen .theater-stage-col {
    width: 76%;
  }

  body.theater-fullscreen .call-top-controls button {
    font-size: 10px;
    padding: 0.35rem 0.25rem;
  }
}

/* =========================================================
   Auto-Hiding Player Bar & Tap-Gesture Feedback Overlays
   ========================================================= */
body.theater-fullscreen #customPlayerBar.bar-hidden {
  opacity: 0 !important;
  pointer-events: none;
  transform: translateY(10px);
}

body.theater-fullscreen #customPlayerBar {
  transition: opacity 0.28s ease, transform 0.28s ease;
}

/* Mobile landscape fullscreen: keep left rail compact & crisp */
@media (max-width: 920px) and (orientation: landscape) {
  body.theater-fullscreen .call-sidebar {
    width: 19%;
    min-width: 128px;
    padding: 0.45rem;
    gap: 0.4rem;
  }

  body.theater-fullscreen .theater-stage-col {
    width: 81%;
  }

  body.theater-fullscreen .call-top-controls button {
    font-size: 11px;
    padding: 0.35rem 0.25rem;
  }
}

/* Double-tap +/- 10s visual ripple pill */
.seek-toast-pill {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(99, 102, 241, 0.6);
  color: #f8fafc;
  font-size: 13px;
  font-weight: 700;
  padding: 0.55rem 1rem;
  border-radius: 9999px;
  pointer-events: none;
  z-index: 35;
  animation: popFade 0.65s ease forwards;
}

.seek-toast-pill.left {
  left: 16%;
}

.seek-toast-pill.right {
  right: 16%;
}

@keyframes popFade {
  0% {
    opacity: 0;
    transform: translateY(-50%) scale(0.88);
  }
  25% {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  80% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(-50%) scale(0.96);
  }
}

/* =========================================================
   Room Chat & Clickable Link Box (Normal + Fullscreen Rail)
   ========================================================= */
.room-chat-box {
  background: #0b1120;
  border: 1px solid #1e293b;
  border-radius: 0.75rem;
  padding: 0.6rem;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  flex-shrink: 0;
  margin-top: auto;
}

.chat-messages-feed {
  max-height: 110px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  font-size: 11px;
  line-height: 1.35;
}

.chat-msg-bubble {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid #1e293b;
  border-radius: 0.5rem;
  padding: 0.3rem 0.5rem;
  color: #e2e8f0;
  word-break: break-word;
}

.chat-msg-link {
  color: #818cf8;
  text-decoration: underline;
  word-break: break-all;
}

.chat-msg-link:hover {
  color: #a5b4fc;
}

/* In Theater Fullscreen: Float Chat Box at Bottom of Right-Side Camera Rail */
body.theater-fullscreen .call-sidebar {
  position: relative;
}

body.theater-fullscreen .webcam-stack {
  padding-bottom: 132px; /* Leave room so bottom webcam isn't hidden behind floating chat */
}

body.theater-fullscreen .room-chat-box {
  position: absolute;
  bottom: 6px;
  left: 6px;
  right: 6px;
  z-index: 45;
  background: rgba(8, 13, 26, 0.86);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(51, 65, 85, 0.85);
  border-radius: 0.65rem;
  padding: 0.4rem;
  box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.65);
}

body.theater-fullscreen .chat-messages-feed {
  max-height: 74px;
  font-size: 10px;
}

body.theater-fullscreen #chatInput {
  font-size: 10px;
  padding: 0.3rem 0.45rem;
}

body.theater-fullscreen #chatSendBtn {
  font-size: 10px;
  padding: 0.3rem 0.5rem;
}

@media (max-width: 768px) {
  body.theater-fullscreen .webcam-stack {
    padding-bottom: 110px;
  }

  body.theater-fullscreen .chat-messages-feed {
    max-height: 56px;
  }
}
